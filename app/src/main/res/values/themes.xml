<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Sunshine" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Launch/splash background stays cream (#F6F3E7) to match the mascot,
             including in dark mode. No values-night override on purpose.
             windowSplashScreenBackground is used by the Android 12+ system
             splash screen; windowBackground covers pre-12 devices and the
             starting window before the first frame. -->
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
    </style>
</resources>
